generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DoAmStatus {
  DRAFT
  PUBLISHED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ApplicationStatus {
  INTERESTED
  ACCEPTED
  WITHDRAWN
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  createdDoAms  DoAm[]            @relation("Creator")
  applications  DoAmApplication[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id            String   @id
  username      String   @unique
  fullName      String
  bio           String?
  phone         String?
  avatarUrl     String?
  skills        String[] @default([])
  availability  String?
  ratingAverage Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount   Int      @default(0)
  createdCount  Int      @default(0)
  completedCount Int     @default(0)
  user          User     @relation(fields: [id], references: [id], onDelete: Cascade)
  location      Location?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Location {
  id                 String   @id @default(cuid())
  profileId          String?  @unique
  doamId             String?  @unique
  latitude           Decimal  @db.Decimal(10, 7)
  longitude          Decimal  @db.Decimal(10, 7)
  city               String
  region             String
  country            String   @default("Nigeria")
  approximateAddress String?
  profile            Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  doam               DoAm?    @relation(fields: [doamId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
}

model DoAm {
  id              String              @id @default(cuid())
  creatorId       String
  title           String
  description     String?
  reward          Decimal             @db.Decimal(12, 2)
  category        String?
  status          DoAmStatus          @default(DRAFT)
  scheduledAt     DateTime?
  recurrence      String?
  deadline        DateTime?
  instructions    String?
  isMultiPerson   Boolean             @default(false)
  maxParticipants Int                 @default(1)
  creator         User                @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  location        Location?
  applications    DoAmApplication[]
  conversations   Conversation[]
  statusHistory   DoAmStatusHistory[]
  comments        Comment[]
  likes           Like[]
  saves           SavedDoAm[]
  ratings         Rating[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([creatorId])
  @@index([status, createdAt])
}

model DoAmApplication {
  id          String            @id @default(cuid())
  doamId      String
  applicantId String
  status      ApplicationStatus @default(INTERESTED)
  doam        DoAm              @relation(fields: [doamId], references: [id], onDelete: Cascade)
  applicant   User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([doamId, applicantId])
  @@index([doamId, status])
}

model DoAmStatusHistory {
  id          String     @id @default(cuid())
  doamId      String
  changedById String
  status      DoAmStatus
  doam        DoAm       @relation(fields: [doamId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
}

model Conversation {
  id          String   @id @default(cuid())
  doamId      String
  requesterId String
  doerId      String
  doam        DoAm     @relation(fields: [doamId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime @default(now())

  @@unique([doamId, requesterId, doerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  doamId    String
  userId    String
  content   String
  doam      DoAm     @relation(fields: [doamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([doamId, createdAt])
}

model Like {
  id     String @id @default(cuid())
  doamId String
  userId String
  doam   DoAm   @relation(fields: [doamId], references: [id], onDelete: Cascade)

  @@unique([doamId, userId])
}

model SavedDoAm {
  id     String @id @default(cuid())
  doamId String
  userId String
  doam   DoAm   @relation(fields: [doamId], references: [id], onDelete: Cascade)

  @@unique([doamId, userId])
}

model Rating {
  id          String   @id @default(cuid())
  doamId      String
  raterId     String
  ratedUserId String
  score       Int
  review      String?
  doam        DoAm     @relation(fields: [doamId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([doamId, raterId, ratedUserId])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  type        String
  title       String
  body        String?
  entityId    String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt, createdAt])
}
