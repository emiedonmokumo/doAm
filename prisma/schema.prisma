generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskCategory {
  PICKUP_DELIVERY
  QUEUEING
  FAVOR
  QUICK_REPAIR
}

enum SettlementMethod {
  CASH_ON_DELIVERY
  DIRECT_TRANSFER
}

enum TaskStatus {
  POSTED
  CLAIMED
  EN_ROUTE_PICKUP
  ARRIVED_PICKUP
  PROOF_SUBMITTED
  EN_ROUTE_DROPOFF
  ARRIVED_DROPOFF
  COMPLETED
  CANCELLED
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  createdTasks  Task[]            @relation("TaskPoster")
  assignedTasks Task[]            @relation("TaskRunner")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id            String   @id @default(cuid())
  username      String   @unique
  fullName      String
  bio           String?
  phone         String?
  avatarUrl     String?
  skills        String[] @default([])
  availability  String?
  ratingAverage Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount   Int      @default(0)
  createdCount  Int      @default(0)
  completedCount Int     @default(0)
  user          User     @relation(fields: [id], references: [id], onDelete: Cascade)
  location      Location?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Location {
  id                 String   @id @default(cuid())
  profileId          String   @unique
  latitude           Decimal  @db.Decimal(10, 7)
  longitude          Decimal  @db.Decimal(10, 7)
  city               String
  region             String
  approximateAddress String?
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
}

model Conversation {
  id          String   @id @default(cuid())
  taskId      String   @unique
  posterId    String
  runnerId    String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime @default(now())

  @@index([posterId, createdAt])
  @@index([runnerId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  type        String
  title       String
  body        String?
  entityId    String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt, createdAt])
}

model Task {
  id                    String            @id @default(cuid())
  posterId              String
  runnerId              String?
  title                 String
  description           String?
  category              TaskCategory
  runnerFee             Decimal           @db.Decimal(12, 2)
  estimatedExpenses     Decimal           @db.Decimal(12, 2)
  settlementMethod      SettlementMethod
  status                TaskStatus        @default(POSTED)
  pickupLatitude        Decimal            @db.Decimal(10, 7)
  pickupLongitude       Decimal            @db.Decimal(10, 7)
  pickupCity            String
  pickupRegion          String
  pickupApproximateArea String
  dropoffLatitude       Decimal?           @db.Decimal(10, 7)
  dropoffLongitude      Decimal?           @db.Decimal(10, 7)
  dropoffCity           String?
  dropoffRegion         String?
  dropoffApproximateArea String?
  handshakePinHash      String
  handshakePinEncrypted String?
  pinFailedAttempts     Int                @default(0)
  pinLockedAt           DateTime?
  proofUrl              String?
  proofPublicId         String?
  claimedAt             DateTime?
  completedAt           DateTime?
  poster                User               @relation("TaskPoster", fields: [posterId], references: [id], onDelete: Cascade)
  runner                User?              @relation("TaskRunner", fields: [runnerId], references: [id], onDelete: SetNull)
  conversation          Conversation?
  events                TaskEvent[]
  ratings               TaskRating[]
  images                TaskImage[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([posterId, createdAt])
  @@index([runnerId, status])
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  type      String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskRating {
  id          String   @id @default(cuid())
  taskId      String
  raterId     String
  ratedUserId String
  score       Int
  review      String?
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([taskId, raterId, ratedUserId])
  @@index([ratedUserId])
}

model TaskImage {
  id        String   @id @default(cuid())
  taskId    String
  url       String
  publicId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, order])
}

