DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doam"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_MAPS_API_KEY=""
# Browser key for Maps JavaScript API; restrict it by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase CA certificate PEM used to verify the database TLS connection.
# Required in production (the app refuses unverified TLS). Multi-line PEM or
# single-line with literal \n escapes are both accepted.
# Note: ssl query params in DATABASE_URL (sslmode, sslrootcert, ...) are ignored.
SUPABASE_CA_CERT=""
